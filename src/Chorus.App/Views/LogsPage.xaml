<Page
    x:Class="Chorus.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Chorus.App.ViewModels"
    mc:Ignorable="d"
    x:DefaultBindMode="OneWay">

    <Grid Padding="24,16,24,18" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 标题 + 右侧操作 ================= -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="日志" Style="{StaticResource TitleTextBlockStyle}" />
                <Border
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="11" Opacity="0.75" />
                        <TextBlock Text="{x:Bind Vm.LedgerText, Mode=OneWay}" FontSize="11" Opacity="0.55"
                                   Visibility="{x:Bind Vm.LedgerVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ToggleButton
                    IsChecked="{x:Bind Vm.AutoScroll, Mode=TwoWay}"
                    Padding="10,5"
                    CornerRadius="6"
                    ToolTipService.ToolTip="有新日志时自动滚到底部（往上翻时自动暂停）">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74B;" FontSize="13" />
                        <TextBlock Text="自动滚动" FontSize="12" />
                    </StackPanel>
                </ToggleButton>
                <Button Click="CopyAll_Click" Padding="9,5" CornerRadius="6"
                        ToolTipService.ToolTip="复制当前筛选结果">
                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                </Button>
                <Button Click="Export_Click" Padding="9,5" CornerRadius="6"
                        ToolTipService.ToolTip="导出为 .log 文件">
                    <FontIcon Glyph="&#xE74E;" FontSize="13" />
                </Button>
                <Button Click="Clear_Click" Padding="9,5" CornerRadius="6"
                        ToolTipService.ToolTip="清空日志">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= 筛选栏 ================= -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox
                Width="230"
                PlaceholderText="搜索日志（空格分隔多个关键词）"
                Text="{x:Bind Vm.SearchText, Mode=TwoWay}" />

            <ToggleButton IsChecked="{x:Bind Vm.ShowError, Mode=TwoWay}" Padding="9,5" CornerRadius="6"
                          ToolTipService.ToolTip="显示/隐藏错误">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="7" Height="7" CornerRadius="4" Background="#D93A3F" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.ErrorLabel, Mode=OneWay}" FontSize="12" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton IsChecked="{x:Bind Vm.ShowWarning, Mode=TwoWay}" Padding="9,5" CornerRadius="6"
                          ToolTipService.ToolTip="显示/隐藏警告">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="7" Height="7" CornerRadius="4" Background="#C77E12" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.WarningLabel, Mode=OneWay}" FontSize="12" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton IsChecked="{x:Bind Vm.ShowInfo, Mode=TwoWay}" Padding="9,5" CornerRadius="6"
                          ToolTipService.ToolTip="显示/隐藏信息">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="7" Height="7" CornerRadius="4" Background="#4C8DF6" VerticalAlignment="Center" />
                    <TextBlock Text="信息" FontSize="12" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton IsChecked="{x:Bind Vm.ShowDebug, Mode=TwoWay}" Padding="9,5" CornerRadius="6"
                          ToolTipService.ToolTip="显示/隐藏调试">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="7" Height="7" CornerRadius="4" Background="#8A8A8A" VerticalAlignment="Center" />
                    <TextBlock Text="调试" FontSize="12" />
                </StackPanel>
            </ToggleButton>

            <ComboBox MinWidth="112" VerticalAlignment="Center"
                      ItemsSource="{x:Bind Vm.SourceOptions}"
                      SelectedIndex="{x:Bind Vm.SourceIndex, Mode=TwoWay}" />

            <Border VerticalAlignment="Center"
                    Visibility="{x:Bind Vm.ModuleFilterVisibility, Mode=OneWay}"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="6" Padding="8,3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind Vm.ModuleFilterText, Mode=OneWay}" FontSize="12" />
                    <Button Click="ClearModule_Click" Padding="2,0" MinWidth="0" Height="18" Width="18"
                            Background="Transparent" BorderThickness="0" CornerRadius="9"
                            ToolTipService.ToolTip="清除模块筛选">
                        <FontIcon Glyph="&#xE711;" FontSize="9" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= 日志列表 ================= -->
        <Grid Grid.Row="2">
            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="2">
                <ListView
                    x:Name="LogList"
                    ItemsSource="{x:Bind Vm.Lines}"
                    SelectionMode="None"
                    Padding="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogItem">
                            <Grid
                                Tag="{x:Bind}"
                                Background="{x:Bind RowBackground}"
                                Tapped="Row_Tapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 左侧级别色条 -->
                                <Border Grid.Column="0" Background="{x:Bind BarBrush}" />

                                <!-- 主行：时间 / 级别 / 模块 / 正文 / 链路 / 展开 -->
                                <Grid Grid.Column="1" Padding="10,6,6,6"
                                      ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind TimeText}"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                    <Border Grid.Column="1" CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                            Background="{x:Bind LevelBadgeBackground}">
                                        <TextBlock Text="{x:Bind Level}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{x:Bind LevelBrush}" />
                                    </Border>

                                    <Border Grid.Column="2" CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                            MaxWidth="130"
                                            Background="{x:Bind ModuleBackground}"
                                            Tapped="Module_Tapped" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="只看这个模块">
                                        <TextBlock Text="{x:Bind ModuleText}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{x:Bind ModuleBrush}" />
                                    </Border>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind Message}"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        TextWrapping="{x:Bind MessageWrapping}"
                                        MaxLines="{x:Bind MessageMaxLines}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!-- 链路：这条连接走的策略组 → 节点（Bettbox 请求页的 chain） -->
                                    <Border Grid.Column="4" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                            MaxWidth="220"
                                            Background="{x:Bind RouteBackground}"
                                            Visibility="{x:Bind RouteVisibility}"
                                            ToolTipService.ToolTip="{x:Bind RouteTooltip}">
                                        <TextBlock Text="{x:Bind Route}" FontSize="10"
                                                   Foreground="{x:Bind RouteForeground}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <Button Grid.Column="5" Click="Expand_Click" Tag="{x:Bind}"
                                            Padding="4" MinWidth="0" Width="22" Height="22"
                                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                                            ToolTipService.ToolTip="展开 / 收起">
                                        <FontIcon Glyph="{x:Bind ExpandGlyph}" FontSize="9" />
                                    </Button>
                                </Grid>

                                <!-- 展开后的元信息与操作 -->
                                <StackPanel
                                    Grid.Column="1" Grid.Row="1"
                                    Margin="10,0,8,8" Spacing="6"
                                    Visibility="{x:Bind DetailVisibility}">
                                    <TextBlock Text="{x:Bind MetaText}" FontSize="11" Opacity="0.6" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="复制" Click="CopyOne_Click" Tag="{x:Bind}"
                                                Padding="10,3" FontSize="12" />
                                        <Button Content="只看此模块" Click="Module_Click" Tag="{x:Bind}"
                                                Padding="10,3" FontSize="12"
                                                IsEnabled="{x:Bind HasModule}" />
                                        <Button Content="收起" Click="Expand_Click" Tag="{x:Bind}"
                                                Padding="10,3" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- 空态 -->
            <TextBlock
                Text="{x:Bind Vm.EmptyText, Mode=OneWay}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0.55" IsHitTestVisible="False"
                Visibility="{x:Bind Vm.EmptyVisibility, Mode=OneWay}" />

            <!-- 新日志浮标 -->
            <Button
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,14" Padding="14,6" CornerRadius="14"
                Click="JumpToEnd_Click"
                Visibility="{x:Bind Vm.NewVisibility, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind Vm.NewText, Mode=OneWay}" FontSize="12" />
                </StackPanel>
            </Button>

            <!-- 轻提示 -->
            <Border
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,56" Padding="12,6" CornerRadius="8"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="{x:Bind Vm.ToastVisibility, Mode=OneWay}">
                <TextBlock Text="{x:Bind Vm.ToastText, Mode=OneWay}" FontSize="12" />
            </Border>
        </Grid>
    </Grid>
</Page>
