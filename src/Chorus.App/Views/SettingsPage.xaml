<Page
    x:Class="Chorus.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DefaultBindMode="OneWay">

    <Page.Resources>
        <!-- 排布与 Bettbox 的设置页一致：小字分组标题 + 圆角卡片，卡片里是一行行条目，
             行与行之间一条缩进的分隔线；整行可点，右侧放开关或「当前值 ›」 -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingsRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RowValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="220" />
        </Style>
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Margin" Value="16,0,16,0" />
        </Style>
        <Style x:Key="RowChevronStyle" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE76C;" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!-- HorizontalScrollMode 必须是 Disabled：否则 ScrollViewer 用无限宽度测量内容，
         下面的 Grid 就撑不满，卡片会缩成内容宽度、右侧留一大片空白 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,12,0">
        <!-- 外层不用 StackPanel：它在水平方向会给子元素无限宽，卡片量不出铺满的宽度 -->
        <Grid Padding="24,16,24,32">
        <StackPanel>

            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource SectionHintStyle}" Margin="0,4,0,0"
                       Text="改动即时保存，不需要再点保存。" />

            <InfoBar
                Margin="0,12,0,0"
                IsOpen="{x:Bind Vm.HasMessage}"
                Title="{x:Bind Vm.MessageTitle}"
                Message="{x:Bind Vm.MessageText}"
                Severity="{x:Bind Vm.MessageSeverity}"
                IsClosable="True"
                Closed="Message_Closed" />

            <!-- ===== 网络 ===== -->
            <TextBlock Text="网络" Style="{StaticResource SectionHeaderStyle}" Margin="2,22,0,8" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto"
                          Tag="mixedPort" Tapped="MixedPortRow_Tapped">
                        <StackPanel>
                            <TextBlock Text="混合代理端口" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowSubtitleStyle}"
                                       Text="HTTP 与 SOCKS 共用同一个端口" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Vm.MixedPortLabel}" Style="{StaticResource RowValueStyle}" />
                            <FontIcon Style="{StaticResource RowChevronStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto"
                          Tag="clashApiPort" Tapped="ClashApiPortRow_Tapped">
                        <StackPanel>
                            <TextBlock Text="Clash API 端口" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowSubtitleStyle}"
                                       Text="策略组、规则与延迟测速都走这个接口" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Vm.ClashApiPortLabel}" Style="{StaticResource RowValueStyle}" />
                            <FontIcon Style="{StaticResource RowChevronStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto"
                          Tag="allowLan" Tapped="ToggleRow_Tapped"
                          AutomationProperties.Name="允许局域网连接">
                        <StackPanel>
                            <TextBlock Text="允许局域网连接" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowSubtitleStyle}"
                                       Text="别的设备可以用本机 IP + 混合端口走代理（重启核心后生效）" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AllowLanToggle" Grid.Column="1"
                                      OnContent="" OffContent="" MinWidth="0"
                                      IsHitTestVisible="False" VerticalAlignment="Center"
                                      IsOn="{x:Bind Vm.AllowLan, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto"
                          Tag="systemProxy" Tapped="ToggleRow_Tapped"
                          AutomationProperties.Name="启动后自动设置系统代理">
                        <StackPanel>
                            <TextBlock Text="启动后自动设置系统代理" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowSubtitleStyle}"
                                       Text="开着开关会立即改系统代理；TUN 模式下自动让位" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SystemProxyToggle" Grid.Column="1"
                                      OnContent="" OffContent="" MinWidth="0"
                                      IsHitTestVisible="False" VerticalAlignment="Center"
                                      IsOn="{x:Bind Vm.EnableSystemProxy, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto"
                          Tag="tun" Tapped="ToggleRow_Tapped"
                          AutomationProperties.Name="启用 TUN 模式">
                        <StackPanel>
                            <TextBlock Text="启用 TUN 模式" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowSubtitleStyle}"
                                       Text="接管全部流量，需要以管理员身份运行（重启核心后生效）" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TunToggle" Grid.Column="1"
                                      OnContent="" OffContent="" MinWidth="0"
                                      IsHitTestVisible="False" VerticalAlignment="Center"
                                      IsOn="{x:Bind Vm.EnableTun, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 订阅与节点 ===== -->
            <TextBlock Text="订阅与节点" Style="{StaticResource SectionHeaderStyle}" Margin="2,22,0,4" />
            <TextBlock Style="{StaticResource SectionHintStyle}" Margin="2,0,0,8"
                       Text="订阅链接在左侧「订阅」页管理，可添加多份并分别更新。" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto"
                          Tag="userAgent" Tapped="UserAgentRow_Tapped">
                        <StackPanel>
                            <TextBlock Text="拉取订阅时的 User-Agent" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowSubtitleStyle}"
                                       Text="转换服务按 UA 决定返回格式：sing-box 给原生 JSON（含策略组），clash-verge 给 Clash YAML" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Vm.UserAgentLabel}" Style="{StaticResource RowValueStyle}" />
                            <FontIcon Style="{StaticResource RowChevronStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto"
                          Tag="routing" Tapped="ToggleRow_Tapped"
                          AutomationProperties.Name="使用订阅自带的分流规则">
                        <StackPanel>
                            <TextBlock Text="使用订阅自带的分流规则" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowSubtitleStyle}"
                                       Text="把订阅里的路由规则、规则集与 DNS 合并进配置；关闭则只用内置的规则/全局/直连" />
                        </StackPanel>
                        <ToggleSwitch x:Name="RoutingToggle" Grid.Column="1"
                                      OnContent="" OffContent="" MinWidth="0"
                                      IsHitTestVisible="False" VerticalAlignment="Center"
                                      IsOn="{x:Bind Vm.ApplySubscriptionRouting, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto"
                          Tag="manual" Tapped="ManualRow_Tapped">
                        <StackPanel>
                            <TextBlock Text="手动添加的节点" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowSubtitleStyle}"
                                       Text="粘贴分享链接导入，与订阅节点合并生效" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Vm.ManualNodeSummary}" Style="{StaticResource RowValueStyle}" />
                            <FontIcon Style="{StaticResource RowChevronStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 其他 ===== -->
            <TextBlock Text="其他" Style="{StaticResource SectionHeaderStyle}" Margin="2,22,0,8" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="日志等级" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowSubtitleStyle}"
                                       Text="等级越低越吵，排查路由问题时用 debug" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="116" VerticalAlignment="Center"
                                  ItemsSource="{x:Bind Vm.LogLevels}"
                                  SelectedItem="{x:Bind Vm.LogLevel, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto"
                          Tag="closeToTray" Tapped="ToggleRow_Tapped"
                          AutomationProperties.Name="关闭窗口时最小化到托盘">
                        <StackPanel>
                            <TextBlock Text="关闭窗口时最小化到托盘" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowSubtitleStyle}"
                                       Text="关掉则直接退出程序并停止代理" />
                        </StackPanel>
                        <ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="1"
                                      OnContent="" OffContent="" MinWidth="0"
                                      IsHitTestVisible="False" VerticalAlignment="Center"
                                      IsOn="{x:Bind Vm.CloseToTray, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 页脚：版本号 ===== -->
            <Border Margin="2,26,0,0" Padding="0,14,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="{x:Bind Vm.VersionLine, Mode=OneWay}" FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Style="{StaticResource SectionHintStyle}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0"
                               Text="设置保存在 %LOCALAPPDATA%\Chorus\settings.json，不在安装目录里。" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
