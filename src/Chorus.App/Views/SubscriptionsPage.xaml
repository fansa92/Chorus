<Page
    x:Class="Chorus.App.Views.SubscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Chorus.App.ViewModels"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24,18,24,0">
        <!-- 标题行 -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="订阅" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="添加订阅" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Click="UpdateAll_Click" IsEnabled="{x:Bind Vm.CanUpdateAll, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind Vm.BusyVisibility, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Vm.UpdateAllText, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 消息条 + 摘要 -->
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,12,0,12">
            <InfoBar
                IsOpen="{x:Bind Vm.HasMessage, Mode=OneWay}"
                Title="{x:Bind Vm.MessageTitle, Mode=OneWay}"
                Message="{x:Bind Vm.MessageText, Mode=OneWay}"
                Severity="{x:Bind Vm.MessageSeverity, Mode=OneWay}"
                IsClosable="True"
                Closed="Message_Closed" />
            <TextBlock Text="{x:Bind Vm.SummaryText, Mode=OneWay}"
                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Vm.ActiveHintText, Mode=OneWay}"
                       Opacity="0.5" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 空态 -->
        <StackPanel Grid.Row="2" Spacing="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind Vm.EmptyVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE774;" FontSize="30" Opacity="0.35" HorizontalAlignment="Center" />
            <TextBlock Text="还没有订阅" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="添加一个订阅链接，解析出的节点与策略组会立刻用于生成配置。"
                       Opacity="0.65" FontSize="12" HorizontalAlignment="Center" />
            <Button Content="添加第一个订阅" Click="Add_Click" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 订阅卡片列表（布局参考 Bettbox 的配置列表：一张卡片说清状态，操作就地完成） -->
        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind Vm.Items, Mode=OneWay}"
                  SelectionMode="None"
                  MaxWidth="980"
                  HorizontalAlignment="Left"
                  Padding="0,0,0,20"
                  Visibility="{x:Bind Vm.ListVisibility, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SubscriptionItemViewModel">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{x:Bind CardStroke, Mode=OneWay}"
                        BorderThickness="{x:Bind CardStrokeThickness, Mode=OneWay}"
                        CornerRadius="10"
                        Padding="14,12"
                        Tag="{x:Bind}"
                        Tapped="Card_Tapped"
                        ToolTipService.ToolTip="{x:Bind ActiveTooltip, Mode=OneWay}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <!-- 首字母图标（选中时用强调色，和「使用中」徽标一起表明当前生效的是这份） -->
                            <Border Width="40" Height="40" CornerRadius="10"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind IconLetter}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="17" FontWeight="SemiBold" />
                            </Border>

                            <!-- 名称 / 主机 / 状态 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="300"
                                               VerticalAlignment="Center" />
                                    <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                            Background="{x:Bind BadgeBackground}"
                                            BorderBrush="{x:Bind BadgeBrush}" BorderThickness="1">
                                        <TextBlock Text="{x:Bind BadgeText}" FontSize="10"
                                                   Foreground="{x:Bind BadgeBrush}" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                            Background="#220067C0"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            Visibility="{x:Bind ActiveBadgeVisibility, Mode=OneWay}">
                                        <TextBlock Text="使用中" FontSize="10"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Host}" FontSize="12" Opacity="0.6"
                                           FontFamily="Cascadia Mono, Consolas"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Url}" />
                                <TextBlock Text="{x:Bind DisplayStatus}" FontSize="12" Opacity="0.72"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ErrorText}" FontSize="11"
                                           Foreground="#D13438" TextWrapping="Wrap"
                                           Visibility="{x:Bind ErrorVisibility}" />
                                <!-- 配置检查结论：更新/添加时自动跑一遍 sing-box check，也可手动复查 -->
                                <TextBlock Text="{x:Bind CheckText}" FontSize="11"
                                           Foreground="{x:Bind CheckBrush}"
                                           TextWrapping="Wrap" MaxLines="3"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind CheckVisibility}" />
                            </StackPanel>

                            <!-- 操作区：更新 / 编辑 / 删除（更新中换成进度环） -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <ProgressRing Width="18" Height="18" IsActive="True"
                                              Visibility="{x:Bind BusyVisibility}" />
                                <Button Content="更新" Padding="10,4" FontSize="12"
                                        Tag="{x:Bind}" Click="UpdateItem_Click"
                                        IsEnabled="{x:Bind ButtonsEnabled}"
                                        Visibility="{x:Bind UpdateButtonVisibility}" />
                                <Button Padding="8,4" FontSize="12"
                                        Tag="{x:Bind}" Click="CheckItem_Click"
                                        AutomationProperties.Name="检查配置"
                                        IsEnabled="{x:Bind ButtonsEnabled}"
                                        ToolTipService.ToolTip="检查配置是否可用（sing-box check 静态校验，不启动核心）">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                </Button>
                                <Button Padding="8,4" FontSize="12"
                                        Tag="{x:Bind}" Click="EditItem_Click"
                                        AutomationProperties.Name="编辑订阅"
                                        IsEnabled="{x:Bind ButtonsEnabled}"
                                        ToolTipService.ToolTip="编辑名称或链接">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                </Button>
                                <Button Padding="8,4" FontSize="12"
                                        Tag="{x:Bind}" Click="RemoveItem_Click"
                                        AutomationProperties.Name="删除订阅"
                                        IsEnabled="{x:Bind ButtonsEnabled}"
                                        ToolTipService.ToolTip="删除订阅">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
