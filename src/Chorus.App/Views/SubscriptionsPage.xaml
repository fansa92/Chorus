<Page
    x:Class="Chorus.App.Views.SubscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Chorus.App.ViewModels"
    x:DefaultBindMode="OneWay">

    <ScrollViewer>
        <StackPanel
            MaxWidth="860"
            HorizontalAlignment="Left"
            Spacing="12"
            Padding="24,16,24,24">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="订阅管理" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="添加订阅" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="全部更新" Click="UpdateAll_Click" />
                </StackPanel>
            </Grid>

            <InfoBar
                IsOpen="{x:Bind Vm.HasMessage}"
                Title="{x:Bind Vm.MessageTitle}"
                Message="{x:Bind Vm.MessageText}"
                Severity="{x:Bind Vm.MessageSeverity}"
                IsClosable="False" />

            <TextBlock Opacity="0.7" TextWrapping="Wrap">
                <Run Text="当前共" />
                <Run Text="{x:Bind Vm.TotalNodeCount, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="个节点生效（订阅" />
                <Run Text="{x:Bind Vm.SubscriptionNodeCount, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="个 + 手动" />
                <Run Text="{x:Bind Vm.ManualNodeCount, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="个），可在设置页粘贴分享链接补充手动节点。" />
            </TextBlock>

            <ListView ItemsSource="{x:Bind Vm.Items}" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubscriptionItemViewModel">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12"
                            Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border
                                    Width="36" Height="36" CornerRadius="9"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind IconLetter}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="16" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Url}" Opacity="0.65" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind DisplayStatus}" Opacity="0.65" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="更新" Click="UpdateItem_Click" />
                                    <Button Content="编辑" Click="EditItem_Click" />
                                    <Button Content="删除" Click="RemoveItem_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="提示：点击「添加订阅」或「编辑」会在弹出面板中处理；修改订阅后如核心正在运行，重启核心后生效。" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
