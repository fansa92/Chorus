<Page
    x:Class="Chorus.App.Views.SubscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Chorus.App.ViewModels"
    mc:Ignorable="d"
    x:DefaultBindMode="OneWay">

    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            HorizontalAlignment="Left"
            Spacing="12"
            Padding="24,16,24,24">

            <TextBlock Text="订阅管理" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar
                IsOpen="{x:Bind Vm.HasMessage}"
                Title="{x:Bind Vm.MessageTitle}"
                Message="{x:Bind Vm.MessageText}"
                Severity="{x:Bind Vm.MessageSeverity}"
                IsClosable="False" />

            <TextBlock Text="添加订阅" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox Header="名称（可选）" Text="{x:Bind Vm.NewName, Mode=TwoWay}"
                     PlaceholderText="例如：机场A（留空则自动取名）" />
            <TextBox Header="订阅链接" Text="{x:Bind Vm.NewUrl, Mode=TwoWay}"
                     PlaceholderText="https://example.com/sub" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="添加并更新" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="全部更新" Click="UpdateAll_Click" />
            </StackPanel>

            <TextBlock Text="已添加的订阅" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap">
                <Run Text="当前共" />
                <Run Text="{x:Bind Vm.TotalNodeCount, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="个节点生效（订阅" />
                <Run Text="{x:Bind Vm.SubscriptionNodeCount, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="个 + 手动" />
                <Run Text="{x:Bind Vm.ManualNodeCount, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="个），可在设置页粘贴分享链接补充手动节点。" />
            </TextBlock>

            <ListView ItemsSource="{x:Bind Vm.Items}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubscriptionItemViewModel">
                        <Grid Padding="0,10,0,10" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Url}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind DisplayStatus}" Opacity="0.65" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="更新" Click="UpdateItem_Click" />
                                <Button Content="删除" Click="RemoveItem_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="提示：修改订阅后如核心正在运行，重启核心后生效。" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
