<Page
    x:Class="Chorus.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Chorus.App.ViewModels"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="24,18,24,0">
        <!-- 标题行 -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="规则" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="重新下载规则集" Click="RefreshRuleSets_Click" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <!-- 标签：路由规则 / 规则集 / DNS -->
        <ItemsRepeater Grid.Row="1" Margin="0,14,0,10" ItemsSource="{x:Bind Vm.Tabs}">
            <ItemsRepeater.Layout>
                <StackLayout Orientation="Horizontal" Spacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:RulesTabViewModel">
                    <Border
                        Background="{x:Bind ChipBackground}"
                        BorderBrush="{x:Bind ChipBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,7"
                        Tag="{x:Bind}"
                        Tapped="Tab_Tapped">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{x:Bind ChipForeground}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind CountLabel}" FontSize="11" Opacity="0.6"
                                       Foreground="{x:Bind ChipForeground}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- 配置来源与状态 -->
        <StackPanel Grid.Row="2" Margin="2,0,2,10" Spacing="2">
            <TextBlock Text="{x:Bind Vm.SourceText}" FontSize="12" Opacity="0.75"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Vm.StatusText}" FontSize="11" Opacity="0.55" />
        </StackPanel>

        <!-- ============ 路由规则 ============ -->
        <Grid Grid.Row="3" Visibility="{x:Bind Vm.RouteVisibility}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,20">
                <StackPanel Spacing="8" Visibility="{x:Bind Vm.ContentVisibility}">
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Rules}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RuleRowViewModel">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Tag="{x:Bind}"
                                    Tapped="Rule_Tapped">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <!-- 序号 -->
                                            <Border Width="24" Height="20" CornerRadius="4" VerticalAlignment="Center"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind IndexText}" FontSize="10" Opacity="0.7"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <!-- 条件 -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind ConditionsText}"
                                                       FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <!-- 动作徽标 -->
                                            <Border Grid.Column="2" CornerRadius="4" Padding="7,1" VerticalAlignment="Center"
                                                    Background="{x:Bind ActionBackground}"
                                                    BorderBrush="{x:Bind ActionBrush}" BorderThickness="1">
                                                <TextBlock Text="{x:Bind ActionText}" FontSize="11"
                                                           MaxWidth="200" TextTrimming="CharacterEllipsis"
                                                           Foreground="{x:Bind ActionBrush}" />
                                            </Border>
                                        </Grid>

                                        <!-- 展开：原始 JSON -->
                                        <Border Visibility="{x:Bind DetailVisibility}"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="8" Padding="10,8">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="规则原文" FontSize="10" Opacity="0.55" />
                                                <TextBlock Text="{x:Bind RawJson}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11"
                                                           IsTextSelectionEnabled="True"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- 兜底行 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Width="24" Height="20" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="∞" FontSize="11" Opacity="0.7"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="以上都不匹配（final）" FontSize="12" Opacity="0.75"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Vm.FinalText}" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 规则集 ============ -->
        <Grid Grid.Row="3" Visibility="{x:Bind Vm.RuleSetVisibility}">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="{x:Bind Vm.RuleSetHintText}" FontSize="12" Opacity="0.7"
                           TextWrapping="Wrap" Margin="2,0,2,10" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,20">
                    <ItemsRepeater ItemsSource="{x:Bind Vm.RuleSets}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="330"
                                MinItemHeight="96"
                                MinColumnSpacing="10"
                                MinRowSpacing="10"
                                ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RuleSetViewModel">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{x:Bind Tag}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind TypeBackground}"
                                                    BorderBrush="{x:Bind TypeBrush}" BorderThickness="1">
                                                <TextBlock Text="{x:Bind MetaText}" FontSize="10"
                                                           Foreground="{x:Bind TypeBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind PathText}" FontSize="11" Opacity="0.7"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind UrlText}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{x:Bind HostText}" FontSize="10" Opacity="0.5"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind UsedByText}" FontSize="10"
                                                       Opacity="0.55" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ DNS ============ -->
        <Grid Grid.Row="3" Visibility="{x:Bind Vm.DnsVisibility}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,20">
                <StackPanel Spacing="8" Visibility="{x:Bind Vm.ContentVisibility}">
                    <TextBlock Text="DNS 服务器" FontSize="12" FontWeight="SemiBold" Opacity="0.8" Margin="2,0,0,0" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.DnsServers}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="260"
                                MinItemHeight="76"
                                MinColumnSpacing="10"
                                MinRowSpacing="10"
                                ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:DnsServerViewModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="12,9">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{x:Bind Tag}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,1"
                                                    Background="{x:Bind BadgeBackground}"
                                                    BorderBrush="{x:Bind AccentBrush}" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TypeText}" FontSize="10"
                                                           Foreground="{x:Bind AccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind AddressText}" FontSize="11" Opacity="0.75"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind MetaText}" FontSize="10" Opacity="0.55" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock Text="DNS 规则" FontSize="12" FontWeight="SemiBold" Opacity="0.8"
                               Margin="2,10,0,0" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.DnsRules}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RuleRowViewModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="12,10"
                                        Tag="{x:Bind}" Tapped="Rule_Tapped">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Width="24" Height="20" CornerRadius="4" VerticalAlignment="Center"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind IndexText}" FontSize="10" Opacity="0.7"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ConditionsText}" FontSize="12"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="4" Padding="7,1" VerticalAlignment="Center"
                                                    Background="{x:Bind ActionBackground}"
                                                    BorderBrush="{x:Bind ActionBrush}" BorderThickness="1">
                                                <TextBlock Text="{x:Bind ActionText}" FontSize="11"
                                                           MaxWidth="200" TextTrimming="CharacterEllipsis"
                                                           Foreground="{x:Bind ActionBrush}" />
                                            </Border>
                                        </Grid>
                                        <Border Visibility="{x:Bind DetailVisibility}"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="8" Padding="10,8">
                                            <TextBlock Text="{x:Bind RawJson}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11" IsTextSelectionEnabled="True"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- DNS 兜底 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,2,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Width="24" Height="20" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="∞" FontSize="11" Opacity="0.7"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="以上都不匹配（dns.final）" FontSize="12" Opacity="0.75"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Vm.DnsFinalText}" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 空态 -->
        <TextBlock Grid.Row="3" Text="{x:Bind Vm.EmptyText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.6" Visibility="{x:Bind Vm.EmptyVisibility}" />
    </Grid>
</Page>
