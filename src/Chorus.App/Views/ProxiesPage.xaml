<Page
    x:Class="Chorus.App.Views.ProxiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Chorus.App.ViewModels"
    x:DefaultBindMode="OneWay">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24,18,24,24">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="策略组" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="刷新" Click="Refresh_Click" />
                <Button Content="全部测速" Click="TestAll_Click" />
                <TextBlock Text="{x:Bind Vm.StatusText}" VerticalAlignment="Center" Margin="4,0,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <TextBox
            Grid.Row="1"
            Margin="0,12,0,12"
            PlaceholderText="搜索节点名称…"
            Text="{x:Bind Vm.SearchText, Mode=TwoWay}" />

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{x:Bind Vm.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProxyGroupViewModel">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12,14,12"
                            Margin="0,0,0,10">
                            <StackPanel>
                                <!-- 组头：图标 + 名称/类型 + 测速 + 展开 -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Border
                                        Width="36" Height="36" CornerRadius="9"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind IconLetter}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="16" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind SubtitleText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="测速" Click="TestGroup_Click"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="3" Click="ToggleGroup_Click"
                                            ToolTipService.ToolTip="展开 / 收起">
                                        <FontIcon Glyph="{x:Bind ExpandGlyph}" FontSize="14" />
                                    </Button>
                                </Grid>

                                <!-- 节点卡片网格 -->
                                <ItemsRepeater
                                    ItemsSource="{x:Bind Members}"
                                    Visibility="{x:Bind NodesVisibility}"
                                    Margin="0,10,0,0">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            MinItemWidth="210"
                                            MinItemHeight="36"
                                            MinColumnSpacing="8"
                                            MinRowSpacing="4"
                                            ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProxyMemberViewModel">
                                            <Border
                                                Background="{x:Bind CardBackground}"
                                                BorderBrush="{x:Bind CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Margin="0,0,0,4"
                                                Tapped="Member_Tapped">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <SymbolIcon Symbol="Accept"
                                                                Visibility="{x:Bind SelectedVisibility}"
                                                                Foreground="{x:Bind CheckBrush}"
                                                                VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind Name}"
                                                               Margin="7,0,8,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind DelayBadgeText}"
                                                               Foreground="{x:Bind DelayBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
