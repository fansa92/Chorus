<Page
    x:Class="Chorus.App.Views.ProxiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Chorus.App.ViewModels"
    x:DefaultBindMode="OneWay">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="24,18,24,24">
        <!-- 标题行 -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="策略组" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="刷新" Click="Refresh_Click" />
                <Button Content="全部测速" Click="TestAll_Click" />
                <TextBlock Text="{x:Bind Vm.StatusText}" VerticalAlignment="Center" Margin="4,0,0,0"
                           MaxWidth="360" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 搜索 -->
        <TextBox
            Grid.Row="1"
            Margin="0,12,0,10"
            PlaceholderText="搜索节点名称…"
            Text="{x:Bind Vm.SearchText, Mode=TwoWay}" />

        <!-- 横向策略组选择器（可横向滚动） -->
        <ScrollViewer
            Grid.Row="2"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled">
            <ItemsRepeater ItemsSource="{x:Bind Vm.Groups}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProxyGroupViewModel">
                        <Border
                            Padding="10,6"
                            CornerRadius="6"
                            MinWidth="96"
                            MaxWidth="280"
                            Background="{x:Bind ChipBackground}"
                            BorderBrush="{x:Bind ChipBorderBrush}"
                            BorderThickness="1"
                            Tag="{x:Bind}"
                            Tapped="Group_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{x:Bind ChipDotBrush}" />
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SubtitleText}" FontSize="11" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- 选中组标题行 -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,8">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Vm.SelectedGroup.Name}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Vm.SelectedGroup.MemberCountText}" FontSize="12" Opacity="0.7"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="2" Content="本组测速" Click="TestSelectedGroup_Click"
                    IsEnabled="{x:Bind Vm.HasSelectedGroup, Mode=OneWay}" />
        </Grid>

        <!-- 选中组的节点列表（Bettbox 卡片式排布） -->
        <Grid Grid.Row="4">
            <ItemsRepeater ItemsSource="{x:Bind Vm.SelectedGroupNodes, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProxyMemberViewModel">
                        <Grid>
                            <!-- 卡片主体：未选中为主题卡片底+描边，选中为淡 accent 底+accent 描边 -->
                            <Border
                                Background="{x:Bind CardBackground}"
                                BorderBrush="{x:Bind CardBorderBrush}"
                                BorderThickness="{x:Bind CardBorderThickness}"
                                CornerRadius="12"
                                Padding="12,10"
                                Tag="{x:Bind}"
                                Tapped="Member_Tapped">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- 第一行：节点名称（右侧留空给右上角选中徽标） -->
                                    <TextBlock Text="{x:Bind Name}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,30,0"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <!-- 第二行：协议类型徽标 + 延迟 -->
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                                        <Border CornerRadius="4"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind ProtocolBadgeBackground}"
                                                BorderBrush="{x:Bind ProtocolBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{x:Bind ProtocolText}" FontSize="11"
                                                       Foreground="{x:Bind ProtocolBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind DelayBadgeText}"
                                                   Foreground="{x:Bind DelayBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <!-- 右上角圆形选中徽标（Bettbox SelectIcon 风格） -->
                            <Border Width="20" Height="20" CornerRadius="10"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Background="{x:Bind CheckBrush}"
                                    Visibility="{x:Bind SelectedVisibility}">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FB;"
                                          FontSize="12" Foreground="White" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- 空态提示 -->
            <TextBlock Text="核心未运行，或没有匹配的节点"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6"
                       Visibility="{x:Bind Vm.NodesEmptyVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
