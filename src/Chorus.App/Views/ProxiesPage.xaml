<Page
    x:Class="Chorus.App.Views.ProxiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Chorus.App.ViewModels"
    x:DefaultBindMode="OneWay">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24,18,24,0">
        <!-- 标题行 -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="策略组" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="全部测速" Click="TestAll_Click" />
                <Button Content="刷新" Click="Refresh_Click" />
                <TextBlock Text="{x:Bind Vm.StatusText}" VerticalAlignment="Center" Margin="4,0,0,0"
                           MaxWidth="320" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 搜索 -->
        <TextBox
            Grid.Row="1"
            Margin="0,12,0,12"
            PlaceholderText="搜索节点名称或策略组…"
            Text="{x:Bind Vm.SearchText, Mode=TwoWay}" />

        <!-- 策略组：所有组自左向右各占一列，列内是卡片式节点列表（独立垂直滚动） -->
        <Grid Grid.Row="2">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled"
                Padding="0,0,0,20">
                <ItemsRepeater ItemsSource="{x:Bind Vm.Groups, Mode=OneWay}" VerticalAlignment="Stretch">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="14" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProxyGroupViewModel">
                            <Grid Width="330" RowDefinitions="Auto,*" VerticalAlignment="Stretch">
                                <!-- 组头：组名 + 类型/当前节点 + 徽标 + 测速 -->
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,9">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind SubtitleText}" FontSize="11" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <!-- 类型徽标：手动 / 自动 -->
                                            <Border CornerRadius="4" Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind TypeBadgeBackground}"
                                                    BorderBrush="{x:Bind TypeBadgeBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{x:Bind TypeBadgeText}" FontSize="11"
                                                           Foreground="{x:Bind TypeBadgeBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind MemberCountText}" FontSize="12" Opacity="0.6"
                                                       VerticalAlignment="Center" />
                                            <Button Content="测速" Padding="8,3" FontSize="12"
                                                    Tag="{x:Bind}" Click="TestGroup_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 组内节点卡片 -->
                                <ScrollViewer Grid.Row="1" Margin="0,8,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsRepeater ItemsSource="{x:Bind Members}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProxyMemberViewModel">
                                                <Grid>
                                                    <Border
                                                        Background="{x:Bind CardBackground}"
                                                        BorderBrush="{x:Bind CardBorderBrush}"
                                                        BorderThickness="{x:Bind CardBorderThickness}"
                                                        CornerRadius="12"
                                                        Padding="12,10"
                                                        Tag="{x:Bind}"
                                                        Tapped="Member_Tapped">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <!-- 第一行：节点名称（右侧留空给选中徽标） -->
                                                            <TextBlock Text="{x:Bind Name}"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,0,30,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <!-- 第二行：协议类型徽标 + 延迟 -->
                                                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                                                                <Border CornerRadius="4"
                                                                        Padding="5,1"
                                                                        VerticalAlignment="Center"
                                                                        Background="{x:Bind ProtocolBadgeBackground}"
                                                                        BorderBrush="{x:Bind ProtocolBrush}"
                                                                        BorderThickness="1">
                                                                    <TextBlock Text="{x:Bind ProtocolText}" FontSize="11"
                                                                               Foreground="{x:Bind ProtocolBrush}" />
                                                                </Border>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{x:Bind DelayBadgeText}"
                                                                           Foreground="{x:Bind DelayBrush}"
                                                                           FontSize="12"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <!-- 右上角圆形选中徽标（Bettbox SelectIcon 风格） -->
                                                    <Border Width="20" Height="20" CornerRadius="10"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,8,8,0"
                                                            Background="{x:Bind CheckBrush}"
                                                            Visibility="{x:Bind SelectedVisibility}">
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FB;"
                                                                  FontSize="12" Foreground="White" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 空态提示 -->
            <TextBlock Text="{x:Bind Vm.EmptyText, Mode=OneWay}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6"
                       Visibility="{x:Bind Vm.EmptyVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
