<Page
    x:Class="Chorus.App.Views.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Chorus.App.ViewModels"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="24,18,24,0">
        <!-- 标题行 -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Bind Vm.TitleText}" Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Vm.AutoRefreshLabel}" FontSize="12" Opacity="0.75"
                               VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="AutoRefreshSwitch" OnContent="" OffContent="" MinWidth="0"
                                  IsOn="{x:Bind Vm.AutoRefresh, Mode=TwoWay}" />
                </StackPanel>
                <Button Content="{x:Bind Vm.RefreshLabel}" Command="{x:Bind Vm.RefreshCommand}" />
                <Button Content="{x:Bind Vm.CloseAllLabel}" Click="CloseAll_Click" />
            </StackPanel>
        </Grid>

        <!-- 状态与汇总 -->
        <Border Grid.Row="1" Margin="0,12,0,10" Padding="14,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{x:Bind Vm.StatusText}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{x:Bind Vm.SummaryText}" FontSize="12" Opacity="0.75"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- 搜索与筛选 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,150,110,150" ColumnSpacing="10" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" PlaceholderText="{x:Bind Vm.SearchPlaceholder}"
                     TextChanged="SearchBox_TextChanged" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind Vm.KindOptions}"
                      SelectedIndex="{x:Bind Vm.KindIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <ComboBox Grid.Column="2" ItemsSource="{x:Bind Vm.NetworkOptions}"
                      SelectedIndex="{x:Bind Vm.NetworkIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <ComboBox Grid.Column="3" ItemsSource="{x:Bind Vm.SortOptions}"
                      SelectedIndex="{x:Bind Vm.SortIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        </Grid>

        <!-- 操作结果提示 -->
        <InfoBar Grid.Row="3" Margin="0,0,0,8"
                 IsOpen="{x:Bind Vm.HasHint, Mode=TwoWay}"
                 Message="{x:Bind Vm.HintText}"
                 Severity="Informational" />

        <!-- 连接列表 -->
        <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,20">
                <ItemsRepeater ItemsSource="{x:Bind Vm.Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionRowViewModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind TargetText}" FontSize="13"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="360" />
                                            <Border CornerRadius="4" Padding="6,1"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind KindText}" FontSize="10" Opacity="0.8"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{x:Bind NetworkText}" FontSize="10" Opacity="0.6"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind DurationText}" FontSize="10" Opacity="0.6"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind DetailText}" FontSize="11" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind ProcessText}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                            <TextBlock Text="{x:Bind RuleText}" FontSize="11" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                            <TextBlock Text="{x:Bind ChainText}" FontSize="11" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind SpeedText}" FontSize="11" Opacity="0.75" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                                MinWidth="92">
                                        <TextBlock Text="{x:Bind UploadText}" FontSize="11" Opacity="0.75"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind DownloadText}" FontSize="11" Opacity="0.75"
                                                   HorizontalAlignment="Right" />
                                        <Button Content="断开" FontSize="11" Padding="8,3" Margin="0,4,0,0"
                                                HorizontalAlignment="Right"
                                                Tag="{x:Bind}" Click="Close_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock Text="{x:Bind Vm.EmptyText}" FontSize="13" Opacity="0.6"
                       Visibility="{x:Bind Vm.EmptyVisibility}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
