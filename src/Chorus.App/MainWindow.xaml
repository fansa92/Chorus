<Window
    x:Class="Chorus.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
            <TextBlock
                x:Name="AppTitleText"
                Text="Chorus"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                FontSize="14" />
        </Grid>

        <!-- 内容区：左侧导航栏 + 右侧页面（参考 Bettbox 桌面端排布） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="196"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,14,16,10">
                        <Border Width="26" Height="26" CornerRadius="7"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="C" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Chorus" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <ListView
                        x:Name="NavList"
                        Grid.Row="1"
                        SelectionChanged="NavList_SelectionChanged"
                        SelectionMode="Single"
                        Padding="10,4,10,12">
                        <ListViewItem Tag="dashboard" Padding="12,9">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <SymbolIcon Symbol="Home" />
                                <TextBlock Grid.Column="1" Text="仪表盘" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem Tag="proxies" Padding="12,9">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <SymbolIcon Symbol="Send" />
                                <TextBlock Grid.Column="1" Text="策略组" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem Tag="rules" Padding="12,9">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <SymbolIcon Symbol="Bullets" />
                                <TextBlock Grid.Column="1" Text="规则" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem Tag="subscriptions" Padding="12,9">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <SymbolIcon Symbol="Link" />
                                <TextBlock Grid.Column="1" Text="订阅" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem Tag="logs" Padding="12,9">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <SymbolIcon Symbol="Document" />
                                <TextBlock Grid.Column="1" Text="日志" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem Tag="settings" Padding="12,9">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <SymbolIcon Symbol="Setting" />
                                <TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                    </ListView>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>

        <!--
            托盘图标。注意：H.NotifyIcon 默认 ContextMenuMode=PopupMenu，
            原生菜单点击只会执行 MenuFlyoutItem.Command，不会触发 Click 事件，
            因此菜单项统一在代码后端绑定 Command（见 MainWindow.xaml.cs）。
        -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Chorus"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="TrayShowItem" Text="显示主窗口" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="TrayExitItem" Text="退出" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
