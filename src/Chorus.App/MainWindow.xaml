<Window
    x:Class="Chorus.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
            <TextBlock
                x:Name="AppTitleText"
                Text="Chorus"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                FontSize="14" />
        </Grid>

        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            SelectionChanged="NavView_SelectionChanged"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="仪表盘" Tag="dashboard" Icon="Home" />
                <NavigationViewItem Content="订阅" Tag="subscriptions" Icon="Link" />
                <NavigationViewItem Content="策略组" Tag="proxies" Icon="Send" />
                <NavigationViewItem Content="日志" Tag="logs" Icon="Document" />
                <NavigationViewItem Content="设置" Tag="settings" Icon="Setting" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Chorus">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="显示主窗口" Click="ShowWindow_Click" />
                    <MenuFlyoutItem Text="退出" Click="ExitApp_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
